-- Locale (L1 / L1.1, docs/LOCALIZATION.md): player-visible text by key. Shared.
--   Locale.T(key, args?, lang?)  the text of `key` in `lang` (default: Current()), "{name}" placeholders filled from
--                                `args`; an argument may itself be a key ({ key = "stage.name.Stage6", args = … }); a
--                                string with plural forms picks one by args.count. Fallback: lang -> English -> the key.
--   Locale.Current()             the player's language on a client (player attribute Language, else Locale.Resolve of the
--                                client's account and device locales); "en" on the server, which never builds translated text but sends keys
--   Locale.Changed               client: fires when the language changes
--   Locale.Reject(reason, specific?, args?, fallback?)
--                                the text of a refused request: specific[reason], else common.reject.<reason>, else fallback
--   Locale.SetKey(label, key, args?) / Locale.SetText(label, text)
--                                a label shows a key (attributes LocKey / LocArgs + tag Loc, rendered per player by
--                                LocalizedText.client) or a literal (times, star lines; the key is cleared)
-- The texts come from localization/strings.csv (key, context, English, translations side by side), compiled by
-- `python tools/loc.py build` into ReplicatedStorage.Strings.<lang> (["area.thing.detail"] = "…" or { plural forms }).
-- Never edit those modules; tools/loc.py check / lint guard the table and the code. Keys are never renamed once shipped.
-- The pseudo-language "qps" (English with accents, 40 % longer, in [!! … !!]) is selectable in Studio and by admins:
-- on screen, text without the brackets is a literal in the code, cut-off text is too long.

local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local LocalizationService = game:GetService("LocalizationService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local AdminConfig = require(script.Parent:WaitForChild("AdminConfig"))

local Locale = {}

Locale.Default = "en"
Locale.Supported = { en = "English", cs = "Čeština" } -- languages for players, native names (shown untranslated)
Locale.Order = { "en", "cs" } -- order of the Settings row
Locale.Pseudo = "qps" -- generated test language: Studio and admins only (PseudoAllowed)
Locale.Names = { en = "English", cs = "Čeština", qps = "[Pseudo]" }
Locale.Tag = "Loc"
Locale.KeyAttribute = "LocKey"
Locale.ArgsAttribute = "LocArgs"
Locale.LanguageAttribute = "Language" -- player attribute: the resolved language code (LanguageService)
Locale.SettingAttribute = "LanguageSetting" -- player attribute: the stored choice, "" = automatic
Locale.SystemAttribute = "SystemLocale" -- player attribute: the device's locale id as the client reported it (LanguageService)

-- [lang] = { [key] = text or { plural forms } }, generated by tools/loc.py
local tables = {}
local folder = script.Parent:WaitForChild("Strings")
for _, lang in { "en", "cs", "qps" } do
	tables[lang] = require(folder:WaitForChild(lang))
end
local english = tables[Locale.Default]

-- "cs-cz" -> "cs"; an unsupported locale -> English
function Locale.FromLocaleId(localeId: string?): string
	local code = string.lower(string.match(localeId or "", "^(%a+)") or "")
	return if Locale.Supported[code] then code else Locale.Default
end

-- The language of "automatic": the Roblox account's language when it is a supported one other than English, else the device's
-- (LocalizationService.SystemLocaleId, which the server only gets from the client). Czech is not a Roblox account language,
-- so a Czech player's account says "en-us" and only the device tells.
function Locale.Resolve(accountLocaleId: string?, systemLocaleId: string?): string
	local account = Locale.FromLocaleId(accountLocaleId)
	if account ~= Locale.Default then
		return account
	end
	return Locale.FromLocaleId(systemLocaleId)
end

local isClient = RunService:IsClient()
local localPlayer = if isClient then Players.LocalPlayer else nil

function Locale.Current(): string
	if not localPlayer then
		return Locale.Default
	end
	local code = localPlayer:GetAttribute(Locale.LanguageAttribute)
	if type(code) == "string" and tables[code] then
		return code
	end
	return Locale.Resolve(localPlayer.LocaleId, LocalizationService.SystemLocaleId)
end

-- The pseudo-language is a test tool: Studio sessions and admins
function Locale.PseudoAllowed(player: Player): boolean
	return RunService:IsStudio() or AdminConfig.IsAdmin(player.UserId)
end

-- Values of the Settings row for `player`: "" (automatic), the supported languages, then the pseudo-language if allowed
function Locale.Choices(player: Player): { string }
	local list = { "" }
	for _, code in Locale.Order do
		table.insert(list, code)
	end
	if Locale.PseudoAllowed(player) then
		table.insert(list, Locale.Pseudo)
	end
	return list
end

function Locale.IsValidSetting(player: Player, setting: any): boolean
	return type(setting) == "string" and table.find(Locale.Choices(player), setting) ~= nil
end

local changed = Instance.new("BindableEvent")
Locale.Changed = changed.Event
if localPlayer then
	local last = Locale.Current()
	localPlayer:GetAttributeChangedSignal(Locale.LanguageAttribute):Connect(function()
		local now = Locale.Current()
		if now ~= last then
			last = now
			changed:Fire(now)
		end
	end)
end

-- index of the plural form for `count`: English { one, other }, Czech { one, few (2-4), other }
local function pluralIndex(lang: string, count: number?): number
	if type(count) ~= "number" then
		return 2
	end
	if lang == "cs" then
		if count == 1 then
			return 1
		elseif count >= 2 and count <= 4 and count == math.floor(count) then
			return 2
		end
		return 3
	end
	return if count == 1 then 1 else 2
end

-- Whole number with the language's digit grouping: "12,500" in English, "12 500" (no-break space) in Czech
function Locale.Number(n: number, lang: string?): string
	lang = lang or Locale.Current()
	local text = string.format("%d", math.floor(n))
	local separator = if lang == "cs" then "\u{00A0}" else ","
	local digits = if string.sub(text, 1, 1) == "-" then string.sub(text, 2) else text
	if #digits <= 3 or (lang == "cs" and #digits <= 4) then
		return text -- Czech groups from five digits on ("1500", "12 500")
	end
	-- the separator goes in reversed: the whole string is reversed back byte by byte (Czech's no-break space is 2 bytes in UTF-8)
	local grouped = string.reverse((string.gsub(string.reverse(digits), "(%d%d%d)", "%1" .. string.reverse(separator))))
	if string.sub(grouped, 1, #separator) == separator then
		grouped = string.sub(grouped, #separator + 1)
	end
	return (if digits ~= text then "-" else "") .. grouped
end

-- A number from a million on in short form (EV2a: prices reach ~800 M), three significant digits: "1.23 M", "12.3 M", "123 M",
-- "1.23 B" (Czech "1,23 mil.", "1,23 mld."; strings number.million / number.billion). Below a million: Locale.Number.
function Locale.Compact(n: number, lang: string?): string
	lang = lang or Locale.Current()
	local size = math.abs(n)
	if size < 1e6 then
		return Locale.Number(n, lang)
	end
	local key, unit = "number.million", 1e6
	if size >= 1e9 then
		key, unit = "number.billion", 1e9
	end
	local value = n / unit
	local decimals = if math.abs(value) < 10 then 2 elseif math.abs(value) < 100 then 1 else 0
	local scale = 10 ^ decimals
	value = (if value >= 0 then math.floor(value * scale) else math.ceil(value * scale)) / scale -- cut, not rounded: 1 239 999 -> "1.23 M"
	local text = string.format("%." .. decimals .. "f", value)
	if decimals > 0 then
		text = string.gsub(string.gsub(text, "0+$", ""), "%.$", "") -- "1.50" -> "1.5", "2.00" -> "2"
	end
	return Locale.T(key, { n = { decimal = text } }, lang)
end

-- A decimal written as text ("4.5", e.g. PetClient.Percent) with the language's decimal mark ("4,5" in Czech)
function Locale.Decimal(text: string, lang: string?): string
	lang = lang or Locale.Current()
	return if lang == "cs" then (string.gsub(text, "%.", ",")) else text
end

local function format(value: any, lang: string): string
	if type(value) == "table" and type(value.key) == "string" then
		return Locale.T(value.key, value.args, lang)
	elseif type(value) == "table" and type(value.decimal) == "string" then
		return Locale.Decimal(value.decimal, lang) -- { decimal = "4.5" }: server-written, shown with the viewer's decimal mark
	elseif type(value) == "number" and value == math.floor(value) and math.abs(value) < 1e15 then
		return if math.abs(value) >= 1e6 then Locale.Compact(value, lang) else Locale.Number(value, lang)
	end
	return tostring(value)
end

function Locale.T(key: string, args: { [string]: any }?, lang: string?): string
	lang = lang or Locale.Current()
	local text = (tables[lang :: string] or english)[key]
	if text == nil then
		lang = Locale.Default
		text = english[key]
		if text == nil then
			return key
		end
	end
	if type(text) == "table" then
		local forms = text :: { string }
		text = forms[math.min(pluralIndex(lang :: string, args and args.count), #forms)]
	end
	if args then
		text = string.gsub(text, "{(%w+)}", function(name)
			local value = args[name]
			if value == nil then
				return nil -- an unknown placeholder stays visible
			end
			return format(value, lang :: string)
		end)
	end
	return text
end

function Locale.Has(key: string): boolean
	return english[key] ~= nil
end

-- The text of a refused request's `reason` (a service's Result): the panel's own key in `specific` [reason] = key, else the
-- shared common.reject.<reason> (coins, stale, loading, far, noplot), else `fallback` (default common.reject.failed).
function Locale.Reject(reason: any, specific: { [string]: string }?, args: { [string]: any }?, fallback: string?): string
	local key = type(reason) == "string" and specific and specific[reason]
	if not key and type(reason) == "string" and Locale.Has("common.reject." .. reason) then
		key = "common.reject." .. reason
	end
	return Locale.T(key or fallback or "common.reject.failed", args)
end

-- Display names: the key when it exists, else the config's English name
local function named(key: string, fallback: string): string
	return if english[key] then Locale.T(key) else fallback
end

function Locale.StageName(stage): string
	return named("stage.name." .. stage.key, stage.displayName)
end

function Locale.WorldName(world): string
	return named("world.name." .. world.index, world.name)
end

function Locale.HubName(): string
	return named("hub.name", "Central Island")
end

function Locale.MedalName(medal): string -- an entry of StageConfig.Medals
	return named("medal.name." .. medal.name, medal.name)
end

-- `level` (optional) picks a per-level name on a talent with `names` (talent.name.<id>.<level> above level 1: "Triple Jump")
function Locale.TalentName(talent, level: number?): string -- an entry of TalentConfig.List
	if level and level > 1 and talent.names then
		local index = math.min(level, #talent.names)
		if index > 1 then
			return named("talent.name." .. talent.id .. "." .. index, talent.names[index])
		end
	end
	return named("talent.name." .. talent.id, talent.name)
end

function Locale.EggName(egg): string -- an entry of PetConfig.Eggs
	return named("pet.egg." .. egg.id, egg.name)
end

function Locale.PetKindName(kind: string): string -- a key of PetConfig.Kinds
	return named("pet.kind." .. kind, kind)
end

function Locale.RarityName(rarityId: string): string -- an id of PetConfig.Rarities
	return named("pet.rarity." .. rarityId, rarityId)
end

function Locale.FoodName(food): string -- an entry of GardenConfig.Foods
	return named("food.name." .. food.id, food.name)
end

function Locale.CropName(crop): string -- an entry of CropConfig.Crops
	return named("crop.name." .. crop.id, crop.name)
end

-- What buying `level` of `talent` gives: the per-level text when the talent has one (talent.effect.<id>.<level>), else the
-- talent's general effect (talent.effect.<id>); the config's English as the fallback
function Locale.TalentEffect(talent, level: number): string
	local perLevel = "talent.effect." .. talent.id .. "." .. level
	if english[perLevel] then
		return Locale.T(perLevel)
	end
	return named("talent.effect." .. talent.id, talent.effects and talent.effects[level] or talent.effect)
end

-- A time span: "7 h 59 min", "12 min", "45 s"
function Locale.Duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	if seconds >= 3600 then
		return Locale.T("common.duration.hm", { h = seconds // 3600, m = (seconds % 3600) // 60 })
	elseif seconds >= 60 then
		return Locale.T("common.duration.m", { m = seconds // 60 })
	end
	return Locale.T("common.duration.s", { s = seconds })
end

-- "Cat Lv 12": a pet's name with its level, the way every pet list and label shows it; a named pet (P3b, `name` = the filtered
-- name) shows "Mochi Lv 12" (a name is user data: never translated)
function Locale.PetName(kind: string, level: number, name: string?): string
	if type(name) == "string" and name ~= "" then
		return Locale.T("pet.nameLevel.named", { name = name, level = level })
	end
	return Locale.T("pet.nameLevel", { kind = Locale.PetKindName(kind), level = level })
end

-- The label shows `key` (with `args`) in each viewer's language; the English text is written as the fallback
function Locale.SetKey(label: any, key: string, args: { [string]: any }?)
	label:SetAttribute(Locale.KeyAttribute, key)
	label:SetAttribute(Locale.ArgsAttribute, if args then HttpService:JSONEncode(args) else nil)
	CollectionService:AddTag(label, Locale.Tag)
	label.Text = Locale.T(key, args)
end

-- The label shows a literal (no translation): clears a key set before
function Locale.SetText(label: any, text: string)
	if label:GetAttribute(Locale.KeyAttribute) ~= nil then
		label:SetAttribute(Locale.KeyAttribute, nil)
		label:SetAttribute(Locale.ArgsAttribute, nil)
		CollectionService:RemoveTag(label, Locale.Tag)
	end
	label.Text = text
end

-- English keys that have no text in `lang` (tools/loc.py check is the full check; this one runs inside Studio)
function Locale.Missing(lang: string): { string }
	local list = {}
	for key in english do
		if (tables[lang] or {})[key] == nil then
			table.insert(list, key)
		end
	end
	table.sort(list)
	return list
end

return Locale
